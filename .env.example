# Configuration Google Cloud
GCP_PROJECT_ID=votre-projet-gcp
# Les modèles Gemini 3.x ne sont exposés que sur l'endpoint « global »
GCP_LOCATION=global

# Modèle LLM
MODEL_NAME_RAD=gemini-3.8-flash
MODEL_NAME_LAD=gemini-3.1-pro-preview
TEMPERATURE=0.2

# Print metrics
VAR_LLM_SHOW_COST=true
VAR_LLM_SHOW_LATENCY=true
VAR_LLM_SHOW_RAW_RAD=false
VAR_LLM_SHOW_RAW_LAD=false
VAR_LLM_SHOW_RETRY_WARNINGS=true

# --- LiteLLM (optionnel) ---
# Si API_BASE et API_KEY sont renseignés (et la clé != CHANGE_ME),
# le backend LiteLLM remplace Vertex AI.
# LITELLM_API_BASE=
# LITELLM_API_KEY=CHANGE_ME
# LITELLM_MODEL_RAD=gemini-3.1-flash-preview
# LITELLM_MODEL_LAD=gemini-3.1-pro-preview
# LITELLM_CERT_PATH=
